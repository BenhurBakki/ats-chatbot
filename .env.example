# Server Configuration
PORT=8000
HOST=0.0.0.0

# WhatsApp (Meta Cloud API / Business Platform)
# Setup at: https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_TOKEN=EAAG...your_meta_permanent_or_temp_token
WHATSAPP_PHONE_ID=109283746592817
WHATSAPP_VERIFY_TOKEN=ats_bot_verify_token_secret

# Slack (Slack Bot & Events API)
# Setup at: https://api.slack.com/apps -> OAuth & Permissions / Event Subscriptions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Instagram (Meta Graph API / Messenger API)
# Setup at: https://developers.facebook.com/apps/ -> Messenger -> Instagram Settings
INSTAGRAM_PAGE_ACCESS_TOKEN=EAAG...your_instagram_page_token
INSTAGRAM_VERIFY_TOKEN=ats_bot_verify_token_secret

# Optional LLM API Key for enhanced dynamic synthesis (OpenAI or Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=
